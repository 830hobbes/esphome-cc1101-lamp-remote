# =============================================================================
#  Gaonitz CLED-5501C  —  433.92 MHz LED lamp remote bridge
#  ESP32 (WROOM-32U) + CC1101  ->  ESPHome  ->  Home Assistant
# =============================================================================
#  Replicates the RF remote for a Gaonitz "Round 6-button touch remote control"
#  (FCC ID 2BD2C-ZZ02DY01007, model CLED-5501C) using an ESP32 driving a CC1101
#  radio in ASK/OOK async mode. The CC1101 supplies the 433.92 MHz carrier; the
#  ESP32 RMT peripheral (via ESPHome remote_transmitter) generates the OOK
#  envelope on GDO0.
#
#  Protocol (reverse-engineered with an RTL-SDR + rtl_433; see docs/PROTOCOL.md):
#    - Modulation ........ ASK/OOK at 433.92 MHz
#    - Encoding .......... PWM, INVERTED polarity, constant 1000 us bit period
#                          "1" bit = 240 us HIGH, 760 us LOW
#                          "0" bit = 760 us HIGH, 240 us LOW
#    - Preamble .......... ten "1" bits (nine 240,-760 pairs + 240,-6500;
#                          the tenth bit's LOW is the 6500 us sync gap)
#    - Payload ........... 33 bits (see per-button hex below), sent 5x,
#                          each repeat separated by a 6500 us sync gap
#
#  IMPORTANT POLARITY NOTE: this signal is INVERTED relative to a naive reading.
#  An RTL-SDR / rtl_433 demodulator normalizes polarity away, so a "correct"
#  bit decode does NOT confirm the on-air polarity is right. Getting the lamp to
#  actually respond required inverting HIGH/LOW. If you adapt this for another
#  remote and the SDR decodes perfectly but the device ignores it, suspect
#  polarity first.
#
#  Requires ESPHome >= 2025.11 (native cc1101 component).
# =============================================================================

substitutions:
  name: rf-lamp-bridge
  friendly_name: RF Lamp Bridge
  cs_pin: GPIO5       # CC1101 CSN
  data_pin: GPIO4     # CC1101 GDO0  (any free GPIO; must match your wiring)

esphome:
  name: ${name}
  friendly_name: ${friendly_name}

esp32:
  board: esp32dev
  framework:
    type: esp-idf     # esp-idf RMT path is the most reliable for CC1101 OOK TX

logger:
api:
ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap: {}

captive_portal:

# --- SPI bus (ESP32 default VSPI pins) --------------------------------------
spi:
  clk_pin: GPIO18
  mosi_pin: GPIO23
  miso_pin: GPIO19

# --- CC1101 radio front-end -------------------------------------------------
#  NOTE: gdo0_pin is deliberately NOT set here. On a TX path the component would
#  call pin_mode() on the data pin and sever the RMT->pad routing, so the chip
#  would enter TX but radiate nothing (ESPHome issue #16876). Leaving it unset
#  lets remote_transmitter own the pin; cc1101.begin_tx only flips TX state.
cc1101:
  id: radio
  cs_pin: ${cs_pin}
  frequency: 433.92MHz
  modulation_type: ASK/OOK
  output_power: 11          # dBm, max (range -30..11); confirmed-working value

# --- Envelope generator -----------------------------------------------------
remote_transmitter:
  id: tx
  pin: ${data_pin}
  carrier_duty_percent: 100%
  on_transmit:
    then:
      - cc1101.begin_tx     # radio -> TX just before the burst
  on_complete:
    then:
      - cc1101.set_idle     # radio -> idle after the burst (TX-only)

# =============================================================================
#  Buttons.  Each code is a single flat array containing the full transmission:
#    preamble + 5x (payload + sync gap).  No remote_transmitter `repeat:` block
#    is used, because the repeats and sync gaps are already in the array.
# =============================================================================
